rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner';
    }
    
    function isStudent() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'student';
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwnerOfProperty(propertyId) {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAuthenticated() && isAdmin();
    }

    // Properties collection
    match /properties/{propertyId} {
      // Anyone can read published properties
      allow read: if true;
      
      // Only owners can create properties
      allow create: if isOwner();
      
      // Only the owner of the property or admin can update/delete
      allow update: if isOwnerOfProperty(propertyId) || isAdmin();
      allow delete: if isOwnerOfProperty(propertyId) || isAdmin();
    }

    // Rooms subcollection
    match /properties/{propertyId}/rooms/{roomId} {
      // Anyone can read room details
      allow read: if true;
      
      // Only property owner can manage rooms
      allow create: if isOwnerOfProperty(propertyId);
      allow update: if isOwnerOfProperty(propertyId) || isAdmin();
      allow delete: if isOwnerOfProperty(propertyId) || isAdmin();
    }

    // Bookings collection
    match /bookings/{bookingId} {
      // Users can read their own bookings
      allow read: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || 
         get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.ownerId == request.auth.uid ||
         isAdmin());
      
      // Students can create bookings
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      
      // Owner of property or student can update (for status changes)
      allow update: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid ||
         get(/databases/$(database)/documents/properties/$(resource.data.propertyId)).data.ownerId == request.auth.uid ||
         isAdmin());
      
      allow delete: if isAdmin();
    }

    // Reviews collection
    match /reviews/{reviewId} {
      // Anyone can read reviews
      allow read: if true;
      
      // Students who booked can create reviews
      allow create: if isStudent() && request.resource.data.studentId == request.auth.uid;
      
      // Only review author or admin can update/delete
      allow update: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && 
        (resource.data.studentId == request.auth.uid || isAdmin());
    }
  }
}
