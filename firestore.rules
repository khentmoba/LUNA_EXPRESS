rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && (request.auth.token.role == 'staff' || request.auth.token.role == 'admin');
    }
    function isAdmin() {
      return request.auth != null && request.auth.token.role == 'admin';
    }

    // ──── Orders: kiosk creates, nobody reads via client (#4 + #7) ────
    // Reads/updates go through staff-only callables (KDS). Create is
    // field-validated so clients can't inject junk (#8).
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasOnly([
          'orderId', 'customerName', 'customerAddress', 'customerPhone',
          'items', 'totalAmount', 'type', 'entryType', 'paymentMethod',
          'paymentStatus', 'deliveryFee', 'totalDistance', 'lat', 'lng',
          'timestamp', 'dateLabel', 'status',
          'checkoutSessionId', 'paymongoPaymentId'
        ])
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() >= 1
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.items is list
        && request.resource.data.items.size() >= 1
        && request.resource.data.items.size() <= 50
        && request.resource.data.totalAmount is number
        && request.resource.data.totalAmount >= 0
        && request.resource.data.totalAmount <= 1000000;
      allow read, update, delete: if false;
    }

    // Config: public read-only.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Staff credentials: server only, always.
    match /staff_accounts/{username} {
      allow read, write: if false;
    }

    // Login rate-limit counters: server only.
    match /login_attempts/{key} {
      allow read, write: if false;
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
