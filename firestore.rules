rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Kiosk clients can only create orders, but cannot read, update, or delete them.
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Config collection is read-only for public client access.
    match /config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Staff accounts are only queried/validated via callable Cloud Functions (Admin SDK).
    match /staff_accounts/{username} {
      allow read, write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
